# Razorpay Configuration (Test / Live Key ID)
# Format: rzp_test_xxxxxxxxxxxx or rzp_live_xxxxxxxxxxxx
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Razorpay Private Key Secret (Server-side order creation only, keep secret!)
RAZORPAY_KEY_SECRET=rzp_live_xxxxxxxxxxxx

# Optional: Custom backend endpoint for persisting registrations
# VITE_REGISTRATION_API_URL=https://your-backend.com/api/register
